"use client";


import Link from 'next/link';
import { ShoppingCart } from 'lucide-react';


export default function Navbar({ cartCount = 0 }: { cartCount?: number }) {
return (
<nav className="w-full fixed top-0 left-0 z-50 bg-black/60 backdrop-blur-sm border-b border-blue-900/20">
<div className="container flex items-center justify-between py-4">
<Link href="#" className="text-2xl font-bold text-sky-400">
USA<span className="text-white">stockAI</span>market
</Link>


<div className="flex items-center gap-6">
<Link href="#portfolio" className="hover:text-sky-300">Portfolio</Link>
<Link href="#shop" className="hover:text-sky-300">Shop</Link>
<button className="relative" aria-label="Open cart">
<ShoppingCart className="w-6 h-6" />
{cartCount > 0 && (
<span className="absolute -top-2 -right-2 bg-sky-500 text-black rounded-full text-xs px-2 py-0.5">
{cartCount}
</span>
)}
</button>
</div>
</div>
</nav>
);
}
``````tsx
"use client";


export default function ProductCard({ product, onAdd }: { product: { name: string; price: number; description?: string }, onAdd: () => void }) {
return (
<div className="p-6 bg-black/40 border border-blue-900/30 rounded-2xl shadow-md">
<div className="h-40 w-full bg-gradient-to-br from-slate-800 via-black to-slate-900 rounded-xl mb-4 flex items-center justify-center text-sm text-gray-300">Image</div>
<h4 className="text-xl font-semibold text-sky-400 mb-2">{product.name}</h4>
<p className="text-gray-300 mb-4">{product.description ?? 'AI-powered trading product.'}</p>
<div className="flex items-center justify-between">
<div className="text-lg font-semibold">${product.price}</div>
<button onClick={onAdd} className="px-4 py-2 rounded-lg bg-sky-500 hover:bg-sky-600 text-black font-semibold">Add to Cart</button>
</div>
</div>
);
}
